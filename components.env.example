# Optional. Copy to components.env only for what does not live where
# download_models.py puts it. run.py and apps/frame0_gradio.py both read it at
# startup; it is never committed. These names are read from this file only:
# the same names exported in the shell are ignored.

# Weights, by default under ./models. WAN_ROOT holds Wan-AI/Wan2.1-VACE-14B.
# FOURDIRECTOR_CHECKPOINT=/path/to/step-2610.safetensors
# WAN_ROOT=/path/to/models
# FOURDIRECTOR_SAM2_CHECKPOINT=/path/to/sam2_hiera_large.pt

# The seed the app's Qwen3-VL caption is sampled with.
# FOURDIRECTOR_QWEN3_VL_SEED=42
