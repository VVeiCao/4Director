diff --git a/pixal3d/pipelines/rembg/BiRefNet.py b/pixal3d/pipelines/rembg/BiRefNet.py
index c71a992..0e5d175 100644
--- a/pixal3d/pipelines/rembg/BiRefNet.py
+++ b/pixal3d/pipelines/rembg/BiRefNet.py
@@ -5,6 +5,49 @@ from torchvision import transforms
 from PIL import Image
 
 
+class LazyRembgModel:
+    def __init__(self, model_cls: type, **kwargs):
+        self.model_cls = model_cls
+        self.kwargs = kwargs
+        self.instance = None
+        self.device = None
+
+    def _load(self):
+        if self.instance is not None:
+            return self.instance
+
+        try:
+            self.instance = self.model_cls(**self.kwargs)
+        except OSError as exc:
+            model_name = self.kwargs.get("model_name", "the configured rembg model")
+            raise RuntimeError(
+                f"Failed to load background-removal model {model_name!r}. "
+                "If this is a gated Hugging Face model, authenticate with a token "
+                "that has access to it, or provide an RGBA input that does not "
+                "require background removal."
+            ) from exc
+
+        if self.device is not None:
+            self.instance.to(self.device)
+        return self.instance
+
+    def to(self, device: str):
+        self.device = device
+        if self.instance is not None:
+            self.instance.to(device)
+
+    def cuda(self):
+        self.to("cuda")
+
+    def cpu(self):
+        self.device = "cpu"
+        if self.instance is not None:
+            self.instance.cpu()
+
+    def __call__(self, image: Image.Image) -> Image.Image:
+        return self._load()(image)
+
